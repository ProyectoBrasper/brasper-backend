# Copy to .env (git-ignored) for local runs. Never commit real values.
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# Required in prod (Supabase direct or session pooler, port 5432 - NOT 6543).
# In dev they default to a local Postgres at localhost:5432/brasper.
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Added by the IAM PR:
# JWT_SECRET=
