# Copy to .env (git-ignored) for local runs. Never commit real values.
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# Required in prod (Supabase direct or session pooler, port 5432 - NOT 6543).
# In dev they default to a local Postgres at localhost:5432/brasper.
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Required in prod, at least 32 characters. Generate one with: openssl rand -base64 48
# In dev, if empty, a random key is used (tokens are lost on restart).
JWT_SECRET=

# Optional. true turns on Swagger UI and /v3/api-docs in prod (readable by anyone). Default false.
SWAGGER_ENABLED=false

# Optional. Creates the first ROLE_ADMIN at startup, only if no active admin exists. Needed because only
# an admin can create users. Remove both after the first run.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional. Comma-separated origins the browser may call the API from. Default: the Vercel frontend and localhost:4200.
CORS_ALLOWED_ORIGINS=https://brasper-frontend.vercel.app,http://localhost:4200
